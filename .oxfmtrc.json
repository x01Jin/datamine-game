{
  "ignorePatterns": ["dist", "node_modules", ".codegraph", "public", "legacy"],
  "printWidth": 110,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "objectWrap": "preserve",
  "sortImports": false,
  "endOfLine": "lf"
}
